  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 979269c94d2742f4fa7d36bf44dcfa1d, type: 3}
  m_Name: DB_dialogues
  m_EditorClassIdentifier: Assembly-CSharp::DialoguesSpeeches
  dialogues:
  - speaker: Chalamala
    text: welcome to Fribourg powerful wizard
    scene: Tutorial_first_scene
  - speaker: Powerful wizard
    text: ' ? ? ?'
    scene: Tutorial_first_scene
  - speaker: Chalamala
    text: Thank you for having come to restore the peace in the city
    scene: Tutorial_first_scene
  - speaker: Chalamala
    text: The dragon was on fire
    scene: Room
  - speaker: Resurrected wizard
    text: 'What was that? That thing killed me ! '
    scene: Room
  - speaker: Chalamala
    text: "Well... Have you ever heard of stories starting with \"once upon a time...\"
      ? \nNow it's your time! I am so ready to tell this tale!"
    scene: Room
  - speaker: Chalamala
    text: 'It goes something like this:

      once upon a time Fribourg was collapsing,
      but a powerful wizard arrived from the future'
    scene: Room
  - speaker: Chalamala
    text: He was ready to fight all the evil to save the city and be able to safely
      go back to his time with the benedictions of the freed citizens
    scene: Room
  - speaker: Powerful wizard
    text: I never made these decisions, what are you talking about?!
    scene: Room
  - speaker: Chalamala
    text: Sometimes fate is stronger than us, I am sure you can make it (or at least,
      you don't have much choice)
    scene: Room
  - speaker: Wizard's mind
    text: '* Very weird guy, I guess I only have a way to find out if what he says
      is true or if he''s completekly crazy*'
    scene: Room
  - speaker: Paesant
    text: Great mage, help me!
    scene: Villager
  - speaker: Paesant
    text: 'My farm is ruined, a terrible spell  fell down on us! '
    scene: Villager
  - speaker: Paesant
    text: That devilish goat came straight from hell and scared all my cows...
    scene: Villager
  - speaker: Paesant
    text: Please, go and fight it! We cannot survive the winter without any Gruyere
    scene: Villager
  - speaker: Boulder
    text: '  x x NOTHING  x x'
    scene: Cheese
  - speaker: Boulder
    text: take this cheese
    scene: Swiss_cheese
  - speaker: Chalamala
    text: You have come this far, hence the real fight is yet to come
    scene: dragon
  - speaker: Chalamala
    text: "Tame its flames\n and you will be forever remembered in the Chalamala's
      tale"
    scene: dragon
  - speaker: Chalamala
    text: 'Burn down

      and the lives of you and of all Fribourg''s inhabitants
      will stop there'
    scene: dragon
  - speaker: Scared wizard
    text: 'This guy really knows how to encourage people... '
    scene: dragon
